# MongoDB Atlas Connection String (Either MONGODB_URI or MONGO_URI)
# Make sure to include your database name in the URI path before query params:
# e.g.: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/<your_database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/memory-vault?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/memory-vault?retryWrites=true&w=majority

PORT=5000
JWT_SECRET=your_super_secret_jwt_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
