{
  "name": "memory-vault",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev -- --host 0.0.0.0\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev -- --host 0.0.0.0",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "npm --prefix server run db:seed",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
