# Server & Vercel Environment Variables
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/memory-vault?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client (Optional - defaults to /api on Vercel or http://localhost:5000/api locally)
# VITE_API_URL=https://your-domain.vercel.app/api
